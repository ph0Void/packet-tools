{
  "name": "@packet-tools/server",
  "version": "1.2.1",
  "description": "Backend para Packet-Tools",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx     watch src/app.ts",
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/rewrite-dist.mjs && node scripts/postbuild.mjs",
    "start": "node dist/app.js",
    "migrate": "npx prisma migrate dev --name packet-tools-database",
    "migrate:deploy": "npx prisma migrate deploy",
    "generate": "npx prisma generate && node scripts/patch-generated.mjs",
    "reset": "npx prisma migrate reset --force",
    "seed": "npx tsx src/seed/seed.ts",
    "studio": "npx prisma studio",
    "test": "vitest run",
    "eval": "tsx test/agent-evals/run.ts",
    "test-pt": "tsx test/test-pt/index.ts",
    "test-terminal": "tsx test/test-terminal/index.ts",
    "test-telnet": "tsx test/test-telnet/index.ts telnet",
    "test-ssh": "tsx test/test-ssh/index.ts ssh",
    "test-serial": "tsx test/test-serial/index.ts serial",
    "test-gns3": "tsx test/test-gns3/index.ts gns3",
    "test-pt:check": "tsc -p tsconfig.test-pt.json"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.2",
    "@langchain/community": "^1.1.29",
    "@langchain/core": "^1.2.4",
    "@langchain/google": "^0.2.1",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.5.5",
    "@langchain/openrouter": "^0.4.5",
    "@langchain/react": "^1.0.24",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "ai": "^6.0.208",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "chromadb": "^3.5.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.5.0",
    "deepagents": "^1.14.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^1.5.5",
    "multer": "^2.0.2",
    "nanoid": "^5.1.11",
    "node-schedule": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "serialport": "^13.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "^24.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.19.43",
    "@types/node-schedule": "^2.1.8",
    "@types/pdf-parse": "^1.1.4",
    "@types/serialport": "^8.0.5",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "tsconfig-paths": "^3.15.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}